{
  "collectionName": "components_lesson_resources",
  "info": {
    "displayName": "Resource (PDF)",
    "icon": "attachment",
    "description": "A downloadable PDF attached to a lesson. PDF-only is enforced in src/pdf-only.ts."
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "file": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "color": {
      "type": "string",
      "maxLength": 100
    },
    "externalUrl": {
      "type": "string",
      "maxLength": 500
    },
    "fileType": {
      "type": "string",
      "default": "PDF",
      "maxLength": 50
    },
    "fileSize": {
      "type": "string",
      "maxLength": 50
    }
  }
}
