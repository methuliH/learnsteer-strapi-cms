HOST=0.0.0.0
PORT=1337

# Secrets: generate your own (e.g. `openssl rand -base64 32`), never commit them,
# and pass them at runtime in production (not baked into the Docker image).
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database: local development (docker container learnsteer-strapi-pg on port 5434)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_NAME=learnsteer_strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Database: Neon (use the POOLED connection string, with SSL). Use a database or
# branch dedicated to Strapi, NOT the shared LearnSteer production tables.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/strapi?sslmode=require
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Max size for PDF uploads, in MB (enforced in src/pdf-only.ts)
PDF_MAX_MB=50
